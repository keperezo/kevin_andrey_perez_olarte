resultado8 <- dbGetQuery(con, "
  WITH gasto_cliente AS (
    SELECT
      c.CustomerId,
      c.FirstName || ' ' || c.LastName AS cliente,
      SUM(i.Total) AS gasto_total
    FROM Customer c
    INNER JOIN Invoice i
      ON c.CustomerId = i.CustomerId
    GROUP BY c.CustomerId
  ),

  cuartiles AS (
    SELECT
      cliente,
      gasto_total,
      NTILE(4) OVER (
        ORDER BY gasto_total
      ) AS cuartil
    FROM gasto_cliente
  ),

  resumen_cuartil AS (
    SELECT
      cuartil,
      SUM(gasto_total) AS ingreso_cuartil
    FROM cuartiles
    GROUP BY cuartil
  ),

  total_tienda AS (
    SELECT
      SUM(ingreso_cuartil) AS ingreso_total
    FROM resumen_cuartil
  )

  SELECT
    rc.cuartil,
    ROUND(rc.ingreso_cuartil, 2) AS ingreso_cuartil,
    ROUND(
      rc.ingreso_cuartil
      * 100.0
      / tt.ingreso_total,
      2
    ) AS porcentaje_ingreso
  FROM resumen_cuartil rc
  CROSS JOIN total_tienda tt
  ORDER BY rc.cuartil;
")

resultado8


comparacion_q4 <- dbGetQuery(con, "
  WITH gasto_cliente AS (
    SELECT
      c.CustomerId,
      SUM(i.Total) AS gasto_total
    FROM Customer c
    INNER JOIN Invoice i
      ON c.CustomerId = i.CustomerId
    GROUP BY c.CustomerId
  ),

  cuartiles AS (
    SELECT
      gasto_total,
      NTILE(4) OVER (
        ORDER BY gasto_total
      ) AS cuartil
    FROM gasto_cliente
  ),

  total AS (
    SELECT
      SUM(gasto_total) AS total_tienda
    FROM cuartiles
  )

  SELECT
    ROUND(
      SUM(
        CASE
          WHEN cuartil = 4
          THEN gasto_total
          ELSE 0
        END
      ),
      2
    ) AS ingreso_Q4,
    ROUND(
      SUM(
        CASE
          WHEN cuartil < 4
          THEN gasto_total
          ELSE 0
        END
      ),
      2
    ) AS ingreso_Q1_Q2_Q3,
    ROUND(
      SUM(
        CASE
          WHEN cuartil = 4
          THEN gasto_total
          ELSE 0
        END
      )
      * 100.0
      / MAX(total_tienda),
      2
    ) AS porcentaje_Q4,
    ROUND(
      SUM(
        CASE
          WHEN cuartil < 4
          THEN gasto_total
          ELSE 0
        END
      )
      * 100.0
      / MAX(total_tienda),
      2
    ) AS porcentaje_Q1_Q2_Q3
  FROM cuartiles
  CROSS JOIN total;
")

comparacion_q4

cat(
  "El cuartil superior Q4 representa el ",
  comparacion_q4$porcentaje_Q4,
  "% del ingreso total de la tienda, mientras que los cuartiles Q1, Q2 y Q3 juntos representan el ",
  comparacion_q4$porcentaje_Q1_Q2_Q3,
  "%.\n"
)


