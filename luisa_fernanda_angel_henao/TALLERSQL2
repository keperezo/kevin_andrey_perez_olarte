resultado11 <- dbGetQuery(con, "
  WITH fecha_maxima AS (
    SELECT
      MAX(InvoiceDate) AS fecha_maxima
    FROM Invoice
  ),

  clientes AS (
    SELECT
      c.CustomerId,
      c.FirstName || ' ' || c.LastName AS cliente,
      MAX(i.InvoiceDate) AS ultima_compra,
      COALESCE(
        SUM(i.Total),
        0
      ) AS gasto_historico
    FROM Customer c
    LEFT JOIN Invoice i
      ON c.CustomerId = i.CustomerId
    GROUP BY
      c.CustomerId,
      c.FirstName,
      c.LastName
  ),

  segmentados AS (
    SELECT
      cl.CustomerId,
      cl.cliente,
      cl.ultima_compra,
      cl.gasto_historico,
      CASE
        WHEN cl.ultima_compra IS NULL
          THEN 'inactivo'
        WHEN (
          JULIANDAY(f.fecha_maxima)
          -
          JULIANDAY(cl.ultima_compra)
        ) / 30.0 <= 6
          THEN 'activo'
        WHEN (
          JULIANDAY(f.fecha_maxima)
          -
          JULIANDAY(cl.ultima_compra)
        ) / 30.0 <= 12
          THEN 'en riesgo'
        ELSE 'inactivo'
      END AS segmento
    FROM clientes cl
    CROSS JOIN fecha_maxima f
  ),

  resumen_segmento AS (
    SELECT
      segmento,
      COUNT(*) AS cantidad_clientes,
      ROUND(AVG(gasto_historico), 2) AS gasto_promedio,
      ROUND(SUM(gasto_historico), 2) AS gasto_total
    FROM segmentados
    GROUP BY segmento
  ),

  ranking_clientes AS (
    SELECT
      CustomerId,
      cliente,
      segmento,
      ROUND(gasto_historico, 2) AS gasto_historico,
      RANK() OVER (
        PARTITION BY segmento
        ORDER BY gasto_historico DESC
      ) AS ranking_gasto
    FROM segmentados
  )

  SELECT
    r.segmento,
    r.cantidad_clientes,
    r.gasto_promedio,
    r.gasto_total,
    c.ranking_gasto,
    c.cliente,
    c.gasto_historico
  FROM resumen_segmento r
  INNER JOIN ranking_clientes c
    ON r.segmento = c.segmento
  WHERE c.ranking_gasto <= 3
  ORDER BY
    CASE r.segmento
      WHEN 'activo' THEN 1
      WHEN 'en riesgo' THEN 2
      WHEN 'inactivo' THEN 3
    END,
    c.ranking_gasto;
")

resultado11

