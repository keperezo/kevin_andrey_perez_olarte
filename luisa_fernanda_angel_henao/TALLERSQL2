resultado9 <- dbGetQuery(con, "
  WITH fecha_maxima AS (
    SELECT
      MAX(InvoiceDate) AS fecha_maxima
    FROM Invoice
  ),

  ultima_compra AS (
    SELECT
      c.CustomerId,
      c.FirstName || ' ' || c.LastName AS cliente,
      MAX(i.InvoiceDate) AS ultima_compra
    FROM Customer c
    LEFT JOIN Invoice i
      ON c.CustomerId = i.CustomerId
    GROUP BY
      c.CustomerId,
      c.FirstName,
      c.LastName
  )

  SELECT
    u.CustomerId,
    u.cliente,
    u.ultima_compra,
    f.fecha_maxima,
    ROUND(
      (
        JULIANDAY(f.fecha_maxima)
        -
        JULIANDAY(u.ultima_compra)
      ) / 30.0,
      2
    ) AS meses_transcurridos
  FROM ultima_compra u
  CROSS JOIN fecha_maxima f
  ORDER BY meses_transcurridos DESC;
")

resultado9


## punto 3

resultado10 <- dbGetQuery(con, "
  WITH fecha_maxima AS (
    SELECT
      MAX(InvoiceDate) AS fecha_maxima
    FROM Invoice
  ),

  ultima_compra AS (
    SELECT
      c.CustomerId,
      c.FirstName || ' ' || c.LastName AS cliente,
      MAX(i.InvoiceDate) AS ultima_compra
    FROM Customer c
    LEFT JOIN Invoice i
      ON c.CustomerId = i.CustomerId
    GROUP BY
      c.CustomerId,
      c.FirstName,
      c.LastName
  )

  SELECT
    u.CustomerId,
    u.cliente,
    u.ultima_compra,
    ROUND(
      (
        JULIANDAY(f.fecha_maxima)
        -
        JULIANDAY(u.ultima_compra)
      ) / 30.0,
      2
    ) AS meses_transcurridos,
    CASE
      WHEN u.ultima_compra IS NULL
        THEN 'inactivo'
      WHEN (
        JULIANDAY(f.fecha_maxima)
        -
        JULIANDAY(u.ultima_compra)
      ) / 30.0 <= 6
        THEN 'activo'
      WHEN (
        JULIANDAY(f.fecha_maxima)
        -
        JULIANDAY(u.ultima_compra)
      ) / 30.0 <= 12
        THEN 'en riesgo'
      ELSE 'inactivo'
    END AS segmento
  FROM ultima_compra u
  CROSS JOIN fecha_maxima f
  ORDER BY meses_transcurridos DESC;
")

resultado10


